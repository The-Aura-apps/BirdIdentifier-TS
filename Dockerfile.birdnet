FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
  git \
  ffmpeg \
  libsndfile1 \
  wget \
  && rm -rf /var/lib/apt/lists/*

# Clone BirdNET-Analyzer repository
RUN git clone https://github.com/kahst/BirdNET-Analyzer.git /app/birdnet

# Set working directory to BirdNET
WORKDIR /app/birdnet

# Install Python dependencies
RUN pip install --no-cache-dir \
  librosa==0.10.1 \
  numpy==1.24.3 \
  resampy==0.4.2 \
  Flask==3.0.0 \
  tensorflow==2.15.0 \
  tensorflow-hub==0.15.0 \
  werkzeug==3.0.1

# Create uploads directory
RUN mkdir -p /app/uploads

# Expose port
EXPOSE 8080

# Copy the custom server script to the BirdNET directory
COPY birdnet-server.py /app/birdnet/server.py

# Run the server
CMD ["python", "server.py"]