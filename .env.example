# BirdIdentifier Backend Environment Variables
# Copy this file to .env and update with your values

# Node Environment (development, production, test)
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/bird_identifier
DB_NAME=bird_identifier
DB_USER=user
DB_PASSWORD=password

# OpenAI API Key (for image identification)
OPENAI_API_KEY=your_openai_api_key_here

# BirdNET Service URL
# For local development (BirdNET running locally or in separate terminal):
BIRDNET_URL=http://localhost:8080
# For Docker deployment (using docker-compose), uncomment below:
# BIRDNET_URL=http://birdnet:8080

# Server Port
PORT=3000
